{
  "name": "pi-codearts",
  "version": "0.4.0",
  "type": "module",
  "description": "Native CodeArts OAuth provider for Pi and OMP: renewable login, isolated environments, dynamic models and thinking levels; no CodeArts CLI",
  "license": "MIT",
  "author": "dull-bird",
  "repository": {
    "type": "git",
    "url": "https://github.com/dull-bird/pi-codearts.git"
  },
  "homepage": "https://github.com/dull-bird/pi-codearts#readme",
  "bugs": {
    "url": "https://github.com/dull-bird/pi-codearts/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "codearts",
    "provider",
    "oauth",
    "huawei"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "files": [
    "index.ts",
    "omp.mjs",
    "extension.mjs",
    "stream.mjs",
    "transport.mjs",
    "usage.mjs",
    "core.mjs",
    "login.mjs",
    "environments.mjs",
    "catalog.mjs",
    "sessions.mjs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "TEST-REPORT.md",
    "docs/"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "omp": {
    "extensions": [
      "./omp.mjs"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@oh-my-pi/pi-ai": "*",
    "@oh-my-pi/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-ai": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:live": "node test/live.mjs",
    "test:e2e": "node test/e2e.mjs",
    "test:login": "node test/login-live.mjs",
    "test:refresh": "node test/refresh-live.mjs",
    "test:omp:live": "node test/omp-live.mjs",
    "test:omp:e2e": "node test/omp-e2e.mjs",
    "check": "tsc --noEmit && node --check omp.mjs && node --check extension.mjs && node --check stream.mjs && node --check transport.mjs && node --check usage.mjs",
    "setup": "node setup.mjs",
    "test:usage": "node test/usage-live.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
