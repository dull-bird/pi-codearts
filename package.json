{
  "name": "pi-codearts",
  "version": "0.2.0",
  "type": "module",
  "description": "Native CodeArts OAuth provider for Pi: renewable login, environment profiles, dynamic models and thinking levels; no CodeArts CLI",
  "license": "MIT",
  "author": "dull-bird",
  "repository": { "type": "git", "url": "https://github.com/dull-bird/pi-codearts.git" },
  "homepage": "https://github.com/dull-bird/pi-codearts#readme",
  "bugs": { "url": "https://github.com/dull-bird/pi-codearts/issues" },
  "keywords": ["pi-package", "pi-extension", "codearts", "provider", "oauth", "huawei"],
  "engines": { "node": ">=22.16.0" },
  "files": ["index.ts", "core.mjs", "login.mjs", "environments.mjs", "catalog.mjs", "sessions.mjs", "README.md", "LICENSE", "CHANGELOG.md", "SECURITY.md", "TEST-REPORT.md", "docs/"],
  "pi": { "extensions": ["./index.ts"] },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:live": "node test/live.mjs",
    "test:e2e": "node test/e2e.mjs",
    "test:login": "node test/login-live.mjs",
    "test:refresh": "node test/refresh-live.mjs",
    "check": "tsc --noEmit",
    "setup": "node setup.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
